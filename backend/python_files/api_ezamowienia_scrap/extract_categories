def get_all_field_numbers(parsed_notices):
    """
    Zbiera wszystkie unikalne numery pól z przetworzonych ogłoszeń.
    Przydatne do odkrywania pól które istnieją ale nie zostały wymienione.
    """
    all_fields = set()
    
    for notice in parsed_notices:
        data = notice.get("parsed_data", {})
        for section_key, section_data in data.items():
            for field_key, field_data in section_data.items():
                if field_key.startswith("_"):
                    continue
                all_fields.add(field_key)
    
    # Sortuj naturalnie
    def sort_key(field_num):
        parts = field_num.split('.')
        return tuple(int(p) for p in parts)
    
    return sorted(all_fields, key=sort_key)


def generate_field_coverage_report(parsed_notices):
    """
    Generuje raport pokrycia pól - które pola występują i jak często.
    """
    field_counts = {}
    total_notices = len(parsed_notices)
    
    for notice in parsed_notices:
        data = notice.get("parsed_data", {})
        for section_key, section_data in data.items():
            for field_key, field_data in section_data.items():
                if field_key.startswith("_"):
                    continue
                label = field_data.get("label", "")
                key = f"{field_key} - {label}"
                if key not in field_counts:
                    field_counts[key] = 0
                field_counts[key] += 1
    
    print(f"\n{'=' * 80}")
    print(f"RAPORT POKRYCIA PÓL ({total_notices} ogłoszeń)")
    print(f"{'=' * 80}")
    
    def sort_key(item):
        field_num = item[0].split(' - ')[0]
        parts = field_num.split('.')
        return tuple(int(p) for p in parts)
    
    for key, count in sorted(field_counts.items(), key=sort_key):
        pct = count / total_notices * 100
        bar = '█' * int(pct / 5) + '░' * (20 - int(pct / 5))
        print(f"  {key:60s} {count:4d}/{total_notices} ({pct:5.1f}%) {bar}")


